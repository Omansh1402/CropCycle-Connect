# ─────────────────────────────────────────────────────────────
# CropCycle Connect – Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL  (Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Your Supabase anon / public key  (Settings → API → anon public)
# This key is safe to expose in frontend code.
# ⚠️  NEVER use the service_role key here — it bypasses Row Level Security.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
